# Copy to .env and adjust. Never commit the real .env file.
# Secret used to sign the session cookie (CSRF token). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
DNSGUARD_SECRET_KEY=change-me

# SQLite database file (default: instance/dnsguard.db)
# DNSGUARD_DATABASE=instance/dnsguard.db

# Server binding
DNSGUARD_HOST=127.0.0.1
DNSGUARD_PORT=5000
DNSGUARD_DEBUG=0

# Rate limit for DNS test requests per client IP
DNSGUARD_RATE_LIMIT=1
DNSGUARD_RATE_LIMIT_PER_MINUTE=30
